# Copy these names into your deployment environment or IDE run configuration.
# Spring Boot does not load this file automatically.
SPRING_DATASOURCE_URL=jdbc:mysql:///database_name?cloudSqlInstance=project:region:instance&socketFactory=com.google.cloud.sql.mysql.SocketFactory&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=replace_with_database_user
SPRING_DATASOURCE_PASSWORD=replace_with_database_password
