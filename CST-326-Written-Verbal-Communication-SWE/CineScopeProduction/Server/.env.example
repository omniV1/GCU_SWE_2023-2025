# ASP.NET Core maps double underscores to configuration section separators.
# Supply these through environment variables, user-secrets, or a secret provider.
JwtSettings__Secret=replace_with_at_least_32_random_bytes
MongoDbSettings__ConnectionString=mongodb+srv://username:password@cluster.example.net/database_name
Recaptcha__SiteKey=replace_with_recaptcha_site_key
Recaptcha__SecretKey=replace_with_recaptcha_secret_key

# Development-only admin seed values. Do not configure these in production.
AdminSeed__Username=replace_with_development_admin_username
AdminSeed__Email=replace_with_development_admin_email
AdminSeed__Password=replace_with_strong_development_admin_password
