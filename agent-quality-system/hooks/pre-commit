#!/bin/bash
# Pre-commit hook for Multi-Agent Code Quality System
# Analyzes staged files before allowing commit

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

echo -e "${CYAN}╭──────────────────────────────────────────╮${NC}"
echo -e "${CYAN}│  Multi-Agent Code Quality Gate Check     │${NC}"
echo -e "${CYAN}╰──────────────────────────────────────────╯${NC}"

# Find the agent-quality-system directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENT_SYSTEM_DIR="${SCRIPT_DIR}/.."

# Check if we're in a git repo
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo -e "${RED}Error: Not in a git repository${NC}"
    exit 1
fi

# Get list of staged files (only source code)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(py|java|cs|js|ts|c|cpp|h)$')

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}✓ No source files staged, skipping analysis${NC}"
    exit 0
fi

FILE_COUNT=$(echo "$STAGED_FILES" | wc -l)
echo -e "${YELLOW}Analyzing ${FILE_COUNT} staged file(s)...${NC}"

# Run the quality gate check
cd "$AGENT_SYSTEM_DIR"

# Create temp file list
TEMP_FILE=$(mktemp)
echo "$STAGED_FILES" > "$TEMP_FILE"

# Run Python analysis
RESULT=$(python3 -c "
import sys
import os
sys.path.insert(0, '.')

from agents.enhanced_feature_extractor import EnhancedFeatureExtractor
from agents.all_gate_classifiers import AllGatesClassificationPipeline
import json

# Load config
try:
    with open('data/results/all_gates_optimal_config.json', 'r') as f:
        config = json.load(f)
    pipeline_config = {g: {'activation': c.get('activation', 'sigmoid')} 
                       for g, c in config.get('gates', {}).items()}
except:
    pipeline_config = {}

extractor = EnhancedFeatureExtractor()
pipeline = AllGatesClassificationPipeline(pipeline_config)

# Read file list
with open('$TEMP_FILE', 'r') as f:
    files = [l.strip() for l in f if l.strip()]

failed_files = []
gate_failures = {}

for filepath in files:
    if not os.path.exists(filepath):
        continue
    
    try:
        with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
            code = f.read()
        
        features = extractor.extract_all_features(code, filepath)
        results = pipeline.classify(
            features['bug_features'],
            features['vulnerability_features'],
            features['project_features']
        )
        
        failed_gates = [g for g, v in results.items() 
                       if v == 'FAIL' and g != 'overall' and g != 'coverage_gate']
        
        if failed_gates:
            failed_files.append({'file': filepath, 'gates': failed_gates})
            for g in failed_gates:
                gate_failures[g] = gate_failures.get(g, 0) + 1
    except Exception as e:
        pass

# Output results
if failed_files:
    print('FAILED')
    print(f'Files with issues: {len(failed_files)}')
    for ff in failed_files[:5]:
        print(f\"  {ff['file']}: {', '.join(ff['gates'])}\")
    if len(failed_files) > 5:
        print(f'  ... and {len(failed_files) - 5} more')
else:
    print('PASSED')
" 2>/dev/null)

rm -f "$TEMP_FILE"

# Parse result
if echo "$RESULT" | grep -q "^PASSED"; then
    echo -e "${GREEN}╭──────────────────────────────────────────╮${NC}"
    echo -e "${GREEN}│  ✓ All quality gates passed!             │${NC}"
    echo -e "${GREEN}╰──────────────────────────────────────────╯${NC}"
    exit 0
else
    echo -e "${RED}╭──────────────────────────────────────────╮${NC}"
    echo -e "${RED}│  ✗ Quality gate check failed!            │${NC}"
    echo -e "${RED}╰──────────────────────────────────────────╯${NC}"
    echo ""
    echo -e "${YELLOW}Issues found:${NC}"
    echo "$RESULT" | tail -n +2
    echo ""
    echo -e "${YELLOW}Options:${NC}"
    echo "  1. Fix the issues and try again"
    echo "  2. Skip check: git commit --no-verify"
    echo ""
    exit 1
fi
